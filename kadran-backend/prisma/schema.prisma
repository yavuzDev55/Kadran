// ============================================================
// v4 SCHEMA
//  - time models: TIMED, OPEN_ENDED, MULTI_DAY, ANY_TIME, DEADLINE
//  - a recurring task is a TaskSeries (the rule) + one real Task row per occurrence
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  COURSE
  EXAM
  HOMEWORK
  CUSTOM
}

// The order mirrors the database (values were renamed in place by the v4 migration).
enum TimeType {
  TIMED      // date + startTime + endTime
  DEADLINE   // date + endTime (the due time, defaults to 23:59)
  MULTI_DAY  // rangeStartDate + rangeEndDate (whole days; same day twice = one-day task)
  OPEN_ENDED // date + startTime, no end
  ANY_TIME   // no date, no time — never placed on the calendar
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  timeZone String @default("Europe/Istanbul")

  weekStartsOn  String  @default("MONDAY") // MONDAY | SUNDAY
  dayStartHour  Int     @default(8) // calendar grid start (0-23)
  dayEndHour    Int     @default(22) // calendar grid end (1-24, must be > dayStartHour)
  timeFormat    String  @default("H24") // H24 | H12
  defaultView   String  @default("WEEK") // WEEK | MONTH
  hideCompleted Boolean @default(false)

  tasks  Task[]
  tags   Tag[]
  series TaskSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks TaskTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

// The rule behind a recurring task. Occurrences are generated once, when the series is
// created, and stored as ordinary tasks (Task.seriesId). Deleting the series deletes them.
model TaskSeries {
  id        Int               @id @default(autoincrement())
  pattern   RecurrencePattern
  startDate DateTime          @db.Date
  endDate   DateTime          @db.Date // required, at most 1 year after startDate
  weekDays  String? // WEEKLY: "MONDAY,WEDNESDAY"
  monthDay  Int? // MONTHLY: 1-31, or -1 for the last day of the month

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("task_series")
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  type     TaskType
  timeType TimeType

  // TIMED / OPEN_ENDED / DEADLINE: the day. null for MULTI_DAY and ANY_TIME.
  date DateTime?

  // TIMED: startTime + endTime. OPEN_ENDED: startTime. DEADLINE: endTime (due time).
  startTime String?
  endTime   String?

  // MULTI_DAY: whole days, both ends inclusive
  rangeStartDate DateTime?
  rangeEndDate   DateTime?

  priority Priority @default(MEDIUM)

  // Defaults come from the task type (see task.rules.js)
  isCompletable Boolean @default(true)

  // Custom color — null means fall back to the type default from colors config
  color String?

  // Pinned tasks are listed in the dashboard's Pinned panel regardless of date.
  // For a series the flag is kept identical on every occurrence.
  isPinned Boolean @default(false)

  isCompleted Boolean @default(false)

  userId Int
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags   TaskTag[]

  // Set when this task is one occurrence of a recurring series
  seriesId Int?
  series   TaskSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([rangeStartDate])
  @@index([rangeEndDate])
  @@index([seriesId])
  @@map("tasks")
}

model TaskTag {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  tagId Int
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
  @@map("task_tags")
}

// ============================================================
// FINAL v3 SCHEMA — this is the target/end state.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  COURSE
  EXAM
  HOMEWORK
  CUSTOM
}

enum TimeType {
  TIMED        // date + startTime + endTime (required)
  TIMED_OPEN   // date + startTime, no endTime
  DEADLINE     // date only
  DATE_RANGE   // rangeStartDate + rangeEndDate
  ANYTIME      // no date, no time — free-floating task
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  timeZone String @default("Europe/Istanbul")

  weekStartsOn String  @default("MONDAY")   // MONDAY | SUNDAY
  dayStartHour Int     @default(8)           // calendar grid start (0-23)
  dayEndHour   Int     @default(22)          // calendar grid end (1-24, must be > dayStartHour)
  timeFormat   String  @default("H24")       // H24 | H12
  defaultView  String  @default("WEEK")      // WEEK | MONTH
  hideCompleted Boolean @default(false)

  tasks Task[]
  tags  Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks TaskTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  type     TaskType
  timeType TimeType

  // Shared by TIMED / DEADLINE; null for DATE_RANGE
  date DateTime?

  // TIMED fields (unused when isFlexibleSchedule is true, see schedules)
  startTime String?
  endTime   String?

  // DATE_RANGE fields
  rangeStartDate DateTime?
  rangeStartTime String?
  rangeEndDate   DateTime?
  rangeEndTime   String?

  // Flexible weekly schedule — out of scope in the official v3.0 doc
  // (§11.2), included at the user's request.
  isFlexibleSchedule Boolean        @default(false)
  schedulePattern    String?
  schedules          TaskSchedule[]

  // Recurrence (unchanged from v2)
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  recurrenceStart   DateTime?
  recurrenceEnd     DateTime?
  recurrenceDays    String?
  recurrenceDay     Int?

  priority    Priority @default(MEDIUM)
  
  // Completability — set per task, defaults driven by type in service layer
  isCompletable Boolean @default(true)

  // Custom color — null means fall back to the type default from colors config
  color String?

  // Pinned tasks appear in the daily panel regardless of date
  isPinned Boolean @default(false)

  isCompleted Boolean  @default(false)

  userId Int
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags   TaskTag[]
  completions TaskCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([rangeStartDate])
  @@index([rangeEndDate])
  @@map("tasks")
}

model TaskSchedule {
  id        Int    @id @default(autoincrement())
  dayOfWeek String // MONDAY..SUNDAY
  startTime String // HH:MM
  endTime   String // HH:MM

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dayOfWeek])
  @@index([taskId])
  @@map("task_schedules")
}

model TaskTag {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  tagId Int
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
  @@map("task_tags")
}

model TaskCompletion {
  id             Int      @id @default(autoincrement())
  occurrenceDate DateTime @db.Date

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([taskId, occurrenceDate])
  @@index([taskId])
  @@map("task_completions")
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  DERS
  SINAV
  ODEV
  KISISEL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum TimeType {
  HOURLY
  ALLDAY
  REMINDER
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  timeZone  String    @default("Europe/Istanbul")

  categories Category[]
  tasks      Task[]
  tags       Tag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  color String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks TaskTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?

  type       TaskType
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  timeType TimeType
  date     DateTime

  startTime     String?
  endTime       String?
  reminderTime  String?

  isRecurring       Boolean             @default(false)
  recurrencePattern RecurrencePattern?
  recurrenceStart   DateTime?
  recurrenceEnd     DateTime?
  recurrenceDays    String?
  recurrenceDay     Int?

  priority    Priority @default(MEDIUM)
  isCompleted Boolean  @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags TaskTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@map("tasks")
}

model TaskTag {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  tagId Int
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
  @@map("task_tags")
}